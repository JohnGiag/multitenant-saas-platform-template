generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Keep enums identical to packages/shared-types (checked at compile time).
enum Role {
  SuperAdmin
  TenantAdmin
  User
  Auditor

  @@map("role")
}

enum TenantTier {
  free
  pro
  enterprise

  @@map("tenant_tier")
}

model Tenant {
  id        String     @id @default(uuid(7)) @db.Uuid
  name      String
  tier      TenantTier @default(free)
  // AUTH_PROVIDER=clerk: the Clerk Organization this tenant mirrors (set by its webhooks).
  clerkOrgId String?   @unique @map("clerk_org_id")
  // When Clerk created the event the name came from: an older one, delivered late, changes nothing.
  clerkEventAt DateTime? @map("clerk_event_at") @db.Timestamptz(3)
  // Test mode: the live tenant this sandbox belongs to. Test keys and test data live here, so every isolation rule
  // applies unchanged. Null for a live tenant, which has at most one sandbox.
  sandboxOf String?    @unique @map("sandbox_of") @db.Uuid
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  liveTenant Tenant? @relation("Sandbox", fields: [sandboxOf], references: [id], onDelete: Restrict)
  sandbox    Tenant? @relation("Sandbox")

  users        User[]
  integrations TenantIntegration[]
  apiKeys        ApiKey[]
  pushDevices    PushDevice[]
  invitations    Invitation[]
  passwordResets PasswordReset[]
  authSessions   AuthSession[]
  auditLogs      AuditLog[]
  storageObjects StorageObject[]
  billingAccount BillingAccount?
  webhookEndpoints WebhookEndpoint[]
  webhookDeliveries WebhookDelivery[]
  featureFlags   TenantFeatureFlag[]
  outboxEvents   OutboxEvent[]
  idempotencyKeys IdempotencyKey[]
  usageRecords   UsageRecord[]

  @@map("tenants")
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  email        String
  // Null for users managed by an external auth provider (e.g. Clerk).
  passwordHash String?  @map("password_hash")
  role         Role     @default(User)
  // AUTH_PROVIDER=clerk: the Clerk user this member is. One Clerk user can be a member of several tenants.
  clerkUserId  String?  @map("clerk_user_id")
  // When Clerk created the event the email came from: an older one, delivered late, changes nothing.
  clerkEventAt DateTime? @map("clerk_event_at") @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  pushDevices    PushDevice[]
  passwordResets PasswordReset[]
  authSessions   AuthSession[]

  @@unique([tenantId, email])
  @@unique([tenantId, clerkUserId])
  // user.updated / user.deleted webhooks address a Clerk user across all their tenants.
  @@index([clerkUserId])
  // Sign-in and password reset find an email's accounts before any tenant is known (MAX_ACCOUNTS_PER_EMAIL).
  @@index([email])
  // UUIDv7 ids are time-ordered, so (tenant_id, id) also serves keyset pagination.
  @@index([tenantId, id])
  @@map("users")
}

model TenantIntegration {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  // Free-form so optional modules can add providers without a migration.
  provider        String
  // AES-256-GCM: version byte + 96-bit IV + auth tag + ciphertext, bound to tenant/provider.
  encryptedConfig Bytes    @map("encrypted_config")
  // Written alongside the ciphertext so listing never needs to decrypt.
  maskedConfig    Json     @map("masked_config")
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  // Also serves "all integrations of a tenant"; at most one row per provider, so no paging index.
  @@unique([tenantId, provider])
  @@map("tenant_integrations")
}

// A SuperAdmin's override of a feature flag for one tenant. The flags and their defaults are declared in code.
model TenantFeatureFlag {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  // Free-form so optional modules can add flags without a migration.
  key       String
  enabled   Boolean
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  // Also serves "all overrides of a tenant"; at most one row per flag, so no paging index.
  @@unique([tenantId, key])
  @@map("tenant_feature_flags")
}

model ApiKey {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  name       String
  // Public part of the key: looked up before the tenant is known, hence globally unique.
  prefix     String    @unique
  // SHA-256 of the secret part; the secret is random, so a slow hash adds nothing.
  secretHash Bytes     @map("secret_hash")
  role       Role      @default(User)
  // Narrow the role, never widen it (see decideAccess).
  scopes     String[]
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  // Keyset pagination newest-first over (created_at, id) within a tenant.
  @@index([tenantId, createdAt, id])
  @@map("api_keys")
}

// FCM registration tokens, used by the optional push module (src/optional/push).
model PushDevice {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Within a tenant, one device belongs to whoever registered it last. No tenant can touch another's row.
  @@unique([tenantId, token])
  @@index([tenantId, userId])
  @@map("push_devices")
}

// A pending invitation: the user is created only when they accept it and choose a password.
model Invitation {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  email     String
  role      Role     @default(User)
  // SHA-256 of the single-use token sent by email; the token itself is never stored.
  tokenHash Bytes    @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  // One pending invitation per email and tenant: inviting again replaces it.
  @@unique([tenantId, email])
  @@index([tenantId, id])
  @@map("invitations")
}

// AUTH_PROVIDER=clerk: what Clerk deleted, and when (the event's time). Svix retries late and out of
// order, so a stale created/updated event must not bring back an organization, user or membership.
// Not tenant-owned: it outlives the tenant, and holds Clerk ids only, no PII.
model ClerkDeletion {
  id        String   @id @default(uuid(7)) @db.Uuid
  // An organization id, a user id, or "<organization id>/<user id>" for a membership.
  clerkId   String   @unique @map("clerk_id")
  deletedAt DateTime @map("deleted_at") @db.Timestamptz(3)

  // Old tombstones are deleted as new ones are written.
  @@index([deletedAt])
  @@map("clerk_deletions")
}

// A pending password reset; deleted when used or replaced by a newer request.
model PasswordReset {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash Bytes    @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@map("password_resets")
}

// A signed-in session (local auth): what keeps a user signed in past their short-lived access token. No token is
// stored: refresh tokens are derived from the session and its generation, which each refresh advances.
model AuthSession {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  generation Int       @default(0)
  rotatedAt  DateTime? @map("rotated_at") @db.Timestamptz(3)
  // Pushed forward by each refresh.
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@map("auth_sessions")
}

// Who changed what (ISO 27001): one row per successful write by a signed-in user or API key. Append-only.
// Kept in the actor's own tenant, so a SuperAdmin's actions survive the deletion of the tenant they acted on.
model AuditLog {
  id              String   @id @default(uuid(7)) @db.Uuid
  // The actor's own tenant.
  tenantId        String   @map("tenant_id") @db.Uuid
  // "user" or "apiKey", and its id: no email or name, so no PII beyond the id.
  actorKind       String   @map("actor_kind")
  actorId         String   @map("actor_id") @db.Uuid
  actorRole       Role     @map("actor_role")
  // Set when a SuperAdmin acted on another tenant (X-Tenant-Id). No foreign key: it may be deleted since.
  actedOnTenantId String?  @map("acted_on_tenant_id") @db.Uuid
  method          String
  // The route pattern (e.g. /v1/users/:id), never the raw URL, which can carry filenames or emails.
  route           String
  // The `:id` route parameter, if any.
  targetId        String?  @map("target_id")
  status          Int
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt, id])
  // For the actorId / targetId filters: without them a rare actor scans the tenant's whole trail.
  @@index([tenantId, actorId, createdAt, id])
  @@index([tenantId, targetId, createdAt, id])
  @@map("audit_logs")
}

// Files in the platform bucket, used by the optional storage module (src/optional/storage): counted
// against the tenant's quota, and erased with the tenant. Files in a tenant's own bucket are not tracked.
model StorageObject {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String   @unique
  // Bytes reserved when the upload URL was issued; the URL only accepts exactly this size.
  size       Int
  // The user or API key that asked for the upload URL: it (or a TenantAdmin) may delete the file.
  // No foreign key: users and keys can be removed while their files stay.
  uploaderId String   @map("uploader_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  // Cascade: core tenant deletion must not need to know this optional table. The storage module's
  // deletion hook removes the files from the bucket first.
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, id])
  @@map("storage_objects")
}

// A tenant's Stripe customer and subscription, used by the optional billing module (src/optional/billing). Mirrors
// what Stripe last reported; the tenant's tier follows it.
model BillingAccount {
  id                   String    @id @default(uuid(7)) @db.Uuid
  // One per tenant (also the index for every lookup: webhooks find the row by tenant and customer together).
  tenantId             String    @unique @map("tenant_id") @db.Uuid
  stripeCustomerId     String    @unique @map("stripe_customer_id")
  // The subscription the tier follows; null until the first checkout completes.
  stripeSubscriptionId String?   @map("stripe_subscription_id")
  // Stripe's status (active, trialing, past_due, canceled, ...); null before the first subscription.
  status               String?
  priceId              String?   @map("price_id")
  currentPeriodEnd     DateTime? @map("current_period_end") @db.Timestamptz(3)
  // A scheduled cancellation: the tier stays until then (a job drops it to free at that time).
  cancelAt             DateTime? @map("cancel_at") @db.Timestamptz(3)
  // When Stripe created the last event applied here: an older one (a late retry) changes nothing.
  lastEventAt          DateTime? @map("last_event_at") @db.Timestamptz(3)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Cascade: core tenant deletion must not need to know this optional table. The billing module's deletion hook
  // cancels the subscription in Stripe first.
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("billing_accounts")
}

// Tenant events waiting for OutboxRelay, written in the transaction of the change they report. A row is deleted once
// its event is delivered, so the table holds only what is pending.
model OutboxEvent {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  type          String
  // Ids and roles only: it leaves the platform (see TenantEvent).
  data          Json
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  // A claim moves this forward, so a failed or crashed delivery comes up again by itself.
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  // The W3C trace headers of the request, so its trace continues into the delivery. Empty without telemetry.
  traceContext  Json     @default("{}") @map("trace_context")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  // Not led by tenant_id: the relay looks for due events before it knows any tenant.
  @@index([nextAttemptAt, id])
  @@map("outbox_events")
}

// Requests sent with an Idempotency-Key, kept for 24 hours so a retry gets the first response instead of a second change.
model IdempotencyKey {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  key          String
  principalId  String   @map("principal_id") @db.Uuid
  // SHA-256 of the method, path and body, so the same key on a different request is refused.
  requestHash  String   @map("request_hash")
  // in_progress, done, or secret: finished, with a response that was shown once and so is not stored.
  status       String
  responseBody Json?    @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, key])
  // For the retention sweep, which works by age alone.
  @@index([createdAt])
  @@map("idempotency_keys")
}

// What a tenant used of a meter in one hour, copied from Redis every few minutes (modules/usage).
model UsageRecord {
  id               String   @id @default(uuid(7)) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  meter            String
  periodStart      DateTime @map("period_start") @db.Timestamptz(3)
  quantity         Int
  // How much of it billing has told Stripe about.
  reportedQuantity Int      @default(0) @map("reported_quantity")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, meter, periodStart])
  @@map("usage_records")
}

// Where a tenant's events are delivered, used by the optional webhooks module (src/optional/webhooks).
model WebhookEndpoint {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  url             String
  description     String?
  // Event types sent here; empty means all of them.
  events          String[]
  // The whsec_ signing secret, AES-256-GCM sealed like tenant integrations and bound to the tenant. Shown once.
  encryptedSecret Bytes    @map("encrypted_secret")
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Cascade: core tenant deletion must not need to know this optional table; its queued deliveries are dropped by
  // the worker's own deletion hook.
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  // UUIDv7 ids are time-ordered, so (tenant_id, id) also serves keyset pagination.
  @@index([tenantId, id])
  @@map("webhook_endpoints")
}

// One attempt to deliver an event to an endpoint, kept for 30 days. The payload holds ids only. Response bodies are never
// stored: they come from the tenant's server and could contain anything.
model WebhookDelivery {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  endpointId  String    @map("endpoint_id") @db.Uuid
  eventId     String    @map("event_id")
  eventType   String    @map("event_type")
  attempt     Int
  // Null when no response came back; `error` then says why.
  statusCode  Int?      @map("status_code")
  durationMs  Int       @map("duration_ms")
  error       String?
  nextRetryAt DateTime? @map("next_retry_at") @db.Timestamptz(3)
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([tenantId, endpointId, createdAt, id])
  // For the retention sweep, which works by age alone.
  @@index([createdAt])
  @@map("webhook_deliveries")
}

// The dashboard's text, one row per language and key (GET /v1/translations/:locale). Platform-wide, not
// tenant-owned. A key a language lacks falls back to English, which has them all.
model Translation {
  id     String @id @default(uuid(7)) @db.Uuid
  // A LOCALES code from shared-types, e.g. "el".
  locale String
  key    String
  // Plain text; `{name}` marks a value the dashboard fills in.
  value  String

  @@unique([locale, key])
  @@map("translations")
}
