DATABASE_URL="postgresql://app:app@localhost:5432/enterprise_api?schema=public"
PORT=3000
# API reference (Swagger UI) at /docs and the OpenAPI document at /docs/openapi.json. On by default,
# off when NODE_ENV=production unless set to true.
# API_DOCS=true

# The dashboard's address: invitation and password-reset emails link to it.
APP_URL=http://localhost:3001
# System emails (invitations, password resets) through Resend, always with these platform credentials
# (never a tenant's own integration). Use a send-only key. Without it, invitations answer 503.
RESEND_PLATFORM_KEY=
# Sender address. Defaults to Resend's shared onboarding@resend.dev, which only delivers to your own
# Resend account's address and Resend's test addresses: use an address on a verified domain in production.
# RESEND_PLATFORM_FROM="Acme <no-reply@acme.com>"

# Rate limiting. Single Redis: REDIS_URL. Sentinel (HA): set REDIS_SENTINELS and REDIS_SENTINEL_NAME
# (plus REDIS_PASSWORD if needed); REDIS_URL is then ignored.
REDIS_URL=redis://localhost:6379
# REDIS_SENTINELS=sentinel-1:26379,sentinel-2:26379
# REDIS_SENTINEL_NAME=mymaster
# Background jobs (BullMQ, same Redis). Defaults shown. Retry n waits a random 50-100% of
# JOB_BACKOFF_MS × 2^(n-1); jobs that still fail land in "<queue>-dlq" for inspection and replay.
# JOB_ATTEMPTS=3
# JOB_BACKOFF_MS=1000
# WORKER_CONCURRENCY=5
# DLQ_MAX_ENTRIES=10000
# QUEUE_PREFIX=bull
# Proxies (load balancers) in front of the API; client IPs for rate limits are read that many hops
# from the right of X-Forwarded-For. Never more than you really have: clients can forge the rest.
TRUST_PROXY_HOPS=0
# Shared with the dashboard (apps/web), at least 32 characters. The dashboard forwards each browser's IP
# with it, so sign-in, invitation and reset requests are limited per browser, not all in the dashboard's
# one bucket. Unset: forwarded IPs are ignored. Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# DASHBOARD_PROXY_SECRET=

# "local" (JWT + Argon2id) or "clerk"
AUTH_PROVIDER=local
# Local mode. At least 32 characters. Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Clerk mode (AUTH_PROVIDER=clerk). The Frontend API URL from the Clerk dashboard (API keys page).
# CLERK_ISSUER=https://your-app.clerk.accounts.dev
# Signing secret of the webhook endpoint pointing at <api>/v1/auth/clerk/webhook (Clerk dashboard → Webhooks).
# CLERK_WEBHOOK_SECRET=whsec_
# Comma-separated origins allowed to use Clerk tokens here (the dashboard's), checked against `azp`.
# CLERK_AUTHORIZED_PARTIES=http://localhost:3001

# File storage (optional module "storage"): the platform bucket for tenants without their own "r2"
# integration. Leave all unset for no platform bucket; if you set any, set all (STORAGE_REGION is optional).
# STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_REGION=auto

# Billing (optional module src/optional/billing): the platform's Stripe account. Leave all unset for billing off;
# if you set any, set all. Test mode keys (sk_test_…) until you go live. See README → Billing.
# STRIPE_SECRET_KEY=sk_test_…
# STRIPE_WEBHOOK_SECRET=whsec_…
# STRIPE_PRICE_PRO=price_…
# STRIPE_PRICE_ENTERPRISE=price_…

# Outbound webhooks (optional module src/optional/webhooks): true lets endpoints use http and private addresses,
# to test against a receiver on this machine. Refused in production (NODE_ENV=production).
# WEBHOOKS_ALLOW_PRIVATE=true

# Observability: off unless the API starts with `pnpm start:otel` (or NODE_OPTIONS, see README → Observability). These
# are the standard OpenTelemetry variables. The default endpoint is the local stack (docker-compose.observability.yml).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer …
# OTEL_SERVICE_NAME=enterprise-api
# Switch one signal off with none. Traces take only otlp or none: nothing else goes through the scrubber.
# OTEL_TRACES_EXPORTER=none
# OTEL_METRICS_EXPORTER=none
# OTEL_LOGS_EXPORTER=none

# 32 random bytes, base64. Encrypts tenant BYOK secrets; losing it makes them unreadable.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BYOK_MASTER_KEY=
