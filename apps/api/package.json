{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "prisma generate && nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "node --test \"test/*.test.mjs\"",
    "coverage": "node --test --experimental-test-coverage --enable-source-maps --test-coverage-exclude=\"test/**\" --test-coverage-exclude=\"**/generated/**\" --test-coverage-exclude=\"**/node_modules/**\" \"test/*.test.mjs\"",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.3.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.1",
    "@nestjs/platform-express": "^12.3.1",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@repo/shared-types": "workspace:*",
    "bullmq": "^6.5.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.13",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@types/node": "^24.19.2",
    "prisma": "7.10.1"
  }
}
