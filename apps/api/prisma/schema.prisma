generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Keep enums identical to packages/shared-types (checked at compile time).
enum Role {
  SuperAdmin
  TenantAdmin
  User
  Auditor

  @@map("role")
}

enum TenantTier {
  free
  pro
  enterprise

  @@map("tenant_tier")
}

model Tenant {
  id        String     @id @default(uuid(7)) @db.Uuid
  name      String
  tier      TenantTier @default(free)
  // AUTH_PROVIDER=clerk: the Clerk Organization this tenant mirrors (set by its webhooks).
  clerkOrgId String?   @unique @map("clerk_org_id")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  users        User[]
  integrations TenantIntegration[]
  apiKeys        ApiKey[]
  pushDevices    PushDevice[]
  invitations    Invitation[]
  passwordResets PasswordReset[]

  @@map("tenants")
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  email        String
  // Null for users managed by an external auth provider (e.g. Clerk).
  passwordHash String?  @map("password_hash")
  role         Role     @default(User)
  // AUTH_PROVIDER=clerk: the Clerk user this member is. One Clerk user can be a member of several tenants.
  clerkUserId  String?  @map("clerk_user_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  pushDevices    PushDevice[]
  passwordResets PasswordReset[]

  @@unique([tenantId, email])
  @@unique([tenantId, clerkUserId])
  // user.updated / user.deleted webhooks address a Clerk user across all their tenants.
  @@index([clerkUserId])
  // UUIDv7 ids are time-ordered, so (tenant_id, id) also serves keyset pagination.
  @@index([tenantId, id])
  @@map("users")
}

model TenantIntegration {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  // Free-form so optional modules can add providers without a migration.
  provider        String
  // AES-256-GCM: version byte + 96-bit IV + auth tag + ciphertext, bound to tenant/provider.
  encryptedConfig Bytes    @map("encrypted_config")
  // Written alongside the ciphertext so listing never needs to decrypt.
  maskedConfig    Json     @map("masked_config")
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  // Also serves "all integrations of a tenant"; at most one row per provider, so no paging index.
  @@unique([tenantId, provider])
  @@map("tenant_integrations")
}

model ApiKey {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  name       String
  // Public part of the key: looked up before the tenant is known, hence globally unique.
  prefix     String    @unique
  // SHA-256 of the secret part; the secret is random, so a slow hash adds nothing.
  secretHash Bytes     @map("secret_hash")
  role       Role      @default(User)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  // Keyset pagination newest-first over (created_at, id) within a tenant.
  @@index([tenantId, createdAt, id])
  @@map("api_keys")
}

// FCM registration tokens, used by the optional push module (src/optional/push).
model PushDevice {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  // One device belongs to whoever registered it last.
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@map("push_devices")
}

// A pending invitation: the user is created only when they accept it and choose a password.
model Invitation {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  email     String
  role      Role     @default(User)
  // SHA-256 of the single-use token sent by email; the token itself is never stored.
  tokenHash Bytes    @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  // One pending invitation per email and tenant: inviting again replaces it.
  @@unique([tenantId, email])
  @@index([tenantId, id])
  @@map("invitations")
}

// AUTH_PROVIDER=clerk: what Clerk deleted, and when (the event's time). Svix retries late and out of
// order, so a stale created/updated event must not bring back an organization, user or membership.
// Not tenant-owned: it outlives the tenant, and holds Clerk ids only, no PII.
model ClerkDeletion {
  id        String   @id @default(uuid(7)) @db.Uuid
  // An organization id, a user id, or "<organization id>/<user id>" for a membership.
  clerkId   String   @unique @map("clerk_id")
  deletedAt DateTime @map("deleted_at") @db.Timestamptz(3)

  @@map("clerk_deletions")
}

// A pending password reset; deleted when used or replaced by a newer request.
model PasswordReset {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash Bytes    @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@map("password_resets")
}
