# Where the dashboard's server reaches the API. Server-side only: browsers never call the API directly.
API_URL=http://localhost:3000

# Rate limits per browser on sign-in, invitations and resets (the API sees only this server otherwise).
# Proxies in front of the dashboard (load balancer, Vercel, nginx): the browser's IP is read that many hops
# from the right of X-Forwarded-For. 0 (default) when browsers reach the dashboard directly; then no IP is
# forwarded, since a browser can write that header itself.
TRUST_PROXY_HOPS=0
# The API's DASHBOARD_PROXY_SECRET, the same value. Unset: no IP is forwarded.
# DASHBOARD_PROXY_SECRET=
