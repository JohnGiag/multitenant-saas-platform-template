{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "prisma generate && nest start --watch",
    "start": "node dist/main.js",
    "start:otel": "node --env-file-if-exists=.env --experimental-loader=@opentelemetry/instrumentation/hook.mjs --import ./dist/telemetry.js dist/main.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "node --test --test-concurrency=1 \"test/*.test.mjs\"",
    "test:live": "node --test \"test/live/*.test.mjs\"",
    "coverage": "node --test --test-concurrency=1 --experimental-test-coverage --enable-source-maps --test-coverage-exclude=\"test/**\" --test-coverage-exclude=\"**/generated/**\" --test-coverage-exclude=\"**/node_modules/**\" \"test/*.test.mjs\"",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed-demo": "node scripts/seed-demo.mjs"
  },
  "dependencies": {
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.3.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.1",
    "@nestjs/platform-express": "^12.3.1",
    "@nestjs/swagger": "^12.0.5",
    "@node-rs/argon2": "^2.2.2",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/core": "^3.0.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/instrumentation": "^0.300.0",
    "@opentelemetry/instrumentation-express": "^0.72.0",
    "@opentelemetry/instrumentation-http": "^0.300.0",
    "@opentelemetry/instrumentation-ioredis": "^0.72.0",
    "@opentelemetry/instrumentation-runtime-node": "^0.37.0",
    "@opentelemetry/instrumentation-undici": "^0.34.0",
    "@opentelemetry/sdk-metrics": "^3.0.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@opentelemetry/sdk-trace": "^3.0.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@prisma/instrumentation": "7.10.1",
    "@repo/shared-types": "workspace:*",
    "bullmq": "^6.5.0",
    "bullmq-otel": "^2.0.1",
    "ioredis": "^6.0.0",
    "jose": "^6.2.13",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@types/node": "^24.19.2",
    "prisma": "7.10.1"
  }
}
